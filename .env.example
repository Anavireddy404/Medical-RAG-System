# Groq API Configuration (free, OpenAI-compatible) — get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Database Configuration
DATABASE_URL=sqlite:///./medical_rag.db
# For PostgreSQL: postgresql://user:password@localhost:5432/medical_rag

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this

# API Settings
API_TIMEOUT=30
MAX_WORKERS=4

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Medical Data Sources
PUBMED_API_KEY=optional_pubmed_key
PUBMED_API_URL=https://pubmed.ncbi.nlm.nih.gov/

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Vector Database (Pinecone)
PINECONE_API_KEY=optional_pinecone_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=medical-papers

# AWS Configuration (for cloud deployment)
AWS_ACCESS_KEY_ID=optional_aws_key
AWS_SECRET_ACCESS_KEY=optional_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=medical-rag-data

# Sentry (error tracking)
SENTRY_DSN=optional_sentry_dsn

# Feature Flags
ENABLE_PERSONALIZATION=True
ENABLE_CACHING=True
ENABLE_RATE_LIMITING=True
